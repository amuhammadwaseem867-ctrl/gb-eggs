# ---------------------------------------------------------------------------
# GB Eggs — environment variables. Copy to .env.local and fill in.
# Never commit real keys. Only NEXT_PUBLIC_* values are sent to the browser.
# ---------------------------------------------------------------------------

# Supabase project URL — Dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable (anon) key — safe for the browser; all access is enforced by RLS.
# Dashboard → Project Settings → API Keys → "Publishable key" (or legacy "anon public").
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# OPTIONAL, SERVER-ONLY. Service-role / secret key used solely by the
# admin-only "Settings → Users → Add user" action. Never prefix with
# NEXT_PUBLIC_ and never expose it to the client. Leave empty to invite users
# from the Supabase dashboard instead.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Local testing only (not needed in production)
# ---------------------------------------------------------------------------
# Superuser URL of a local PostgreSQL used by `npm run test:db`
# TEST_DB_ADMIN_URL=postgres://postgres:postgres@localhost:5432
